{
  "name": "besik-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs --port 4173",
    "test": "tsx --test src/lib/*.test.ts",
    "release:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-vps.ps1",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
